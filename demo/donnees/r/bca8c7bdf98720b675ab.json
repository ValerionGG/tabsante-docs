auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-11-06T07:40:25.879153+00:00","relu":{"par":"Claire Martin","le":"2026-10-22T16:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-10-22","revision_le":"2027-10-22"},"motif_refus":null,"vues":0,"utile":1,"mon_vote":false,"reponses":[]},{"id":"e4fbb513-77ba-4a5b-bdc3-a67b5c0eb0e0","racine_id":"e4fbb513-77ba-4a5b-bdc3-a67b5c0eb0e0","version":1,"type":"video","titre":"La désinfection des mains par friction hydro-alcoolique","resume":null,"corps":{"duree":"2:00","credit":"Hôpital universitaire Robert-Debré · lue depuis YouTube, droits réservés à son auteur","youtube_id":"KFK7f8IMGe8"},"source":"Hôpital universitaire Robert-Debré","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène"],"essentiel":false,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-11-06T07:40:25.879153+00:00","relu":{"par":"Claire Martin","le":"2026-10-19T16:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-10-19","revision_le":"2027-10-19"},"motif_refus":null,"vues":0,"utile":2,"mon_vote":true,"reponses":[]},{"id":"186c70cb-31d7-4067-a27e-fe0bcdb39f63","racine_id":"186c70cb-31d7-4067-a27e-fe0bcdb39f63","version":1,"type":"question","titre":"Quelle hygiène des mains entre deux soins chez le même patient ?","resume":null,"corps":{},"source":"Contenu de démonstration · à valider par un référent","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène"],"essentiel":false,"statut":"publie","a_revoir":false,"auteur":{"nom":"Paul Durand","qualite":"IDE"},"cree_le":"2026-11-06T07:40:25.879153+00:00","relu":{"par":"Claire Martin","le":"2026-10-29T17:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-10-29","revision_le":"2027-10-29"},"motif_refus":null,"vues":0,"utile":1,"mon_vote":false,"reponses":[{"id":"dde47445-f09e-43df-86b2-1dd9347ac07a","texte":"Friction hydro-alcoolique avant et après chaque soin, y compris chez le même patient quand on passe d'un site contaminé (change, plaie) à un site propre (injection, cathéter), et après le retrait des gants. Lavage au savon doux seulement si les mains sont visiblement souillées, puis friction une fois les mains sèches.","source":"SF2H, bonnes pratiques en soins de ville, 2015","auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-11-06T07:40:25.879153+00:00","validee":true,"validee_par":"Dr Jean Marchand, Médecin","validee_le":"2026-10-29"}]},{"id":"e2701ca6-ad69-44c0-8875-0292144f96a6","racine_id":"e2701ca6-ad69-44c0-8875-0292144f96a6","version":1,"type":"document","titre":"Bonnes pratiques essentielles en hygiène en soins de ville","resume":null,"corps":{"url":"https://www.sf2h.net/k-stock/data/uploads/2015/11/SF2H_recommandations_bonnes-pratiques-essentielles-en-hygiene-a-l-usage-des-professionnels-de-sante-en-soins-de-ville-2015.pdf"},"source":"SF2H, 2015","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène"],"essentiel":false,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-11-06T07:40:25.879153+00:00","relu":{"par":"Claire Martin","le":"2026-10-17T16:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-10-17","revision_le":"2027-10-17"},"motif_refus":null,"vues":0,"utile":0,"mon_vote":false,"reponses":[]},{"id":"b2414660-fc0a-41cb-96f0-e4940d49e5fc","racine_id":"b2414660-fc0a-41cb-96f0-e4940d49e5fc","version":1,"type":"document","titre":"Hygiène des mains","re