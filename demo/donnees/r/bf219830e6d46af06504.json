:false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-10-23T06:40:11.108151+00:00","relu":{"par":"Claire Martin","le":"2026-10-08T16:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-10-08","revision_le":"2027-10-08"},"motif_refus":null,"vues":0,"utile":1,"mon_vote":false,"reponses":[]},{"id":"91cf7fd3-d6e1-454b-8943-240db72ee52e","racine_id":"91cf7fd3-d6e1-454b-8943-240db72ee52e","version":1,"type":"video","titre":"La désinfection des mains par friction hydro-alcoolique","resume":null,"corps":{"duree":"2:00","credit":"Hôpital universitaire Robert-Debré · lue depuis YouTube, droits réservés à son auteur","youtube_id":"KFK7f8IMGe8"},"source":"Hôpital universitaire Robert-Debré","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène"],"essentiel":false,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-10-23T06:40:11.108151+00:00","relu":{"par":"Claire Martin","le":"2026-10-05T16:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-10-05","revision_le":"2027-10-05"},"motif_refus":null,"vues":0,"utile":2,"mon_vote":true,"reponses":[]},{"id":"5b408314-aee6-4be9-85b6-e488a55263c5","racine_id":"5b408314-aee6-4be9-85b6-e488a55263c5","version":1,"type":"question","titre":"Quelle hygiène des mains entre deux soins chez le même patient ?","resume":null,"corps":{},"source":"Contenu de démonstration · à valider par un référent","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène"],"essentiel":false,"statut":"publie","a_revoir":false,"auteur":{"nom":"Paul Durand","qualite":"IDE"},"cree_le":"2026-10-23T06:40:11.108151+00:00","relu":{"par":"C