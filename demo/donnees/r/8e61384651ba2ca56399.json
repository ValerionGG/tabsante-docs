":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-10-22T19:24:38.301927+00:00","relu":{"par":"Claire Martin","le":"2026-10-07T16:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-10-07","revision_le":"2027-10-07"},"motif_refus":null,"vues":1,"utile":1,"mon_vote":false,"reponses":[]},{"id":"1da2e903-7ea8-49e8-ada9-044848449f38","racine_id":"1da2e903-7ea8-49e8-ada9-044848449f38","version":1,"type":"video","titre":"La désinfection des mains par friction hydro-alcoolique","resume":null,"corps":{"duree":"2:00","credit":"Hôpital universitaire Robert-Debré · lue depuis YouTube, droits réservés à son auteur","youtube_id":"KFK7f8IMGe8"},"source":"Hôpital universitaire Robert-Debré","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène"],"essentiel":false,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-10-22T19:24:38.301927+00:00","relu":{"par":"Claire Martin","le":"2026-10-04T16:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-10-04","revision_le":"2027-10-04"},"motif_refus":null,"vues":1,"utile":2,"mon_vote":false,"reponses":[]},{"id":"dee29995-8836-4fca-b529-7e3f818fa47d","racine_id":"dee29995-8836-4fca-b529-7e3f818fa47d","version":1,"type":"question","titre":"Quelle hygiène des mains entre deux soins chez le même patient ?","resume":null,"corps":{},"source":"Contenu de démonstration · à valider par un référent","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène"],"essentiel":false,"statut":"publie","a_revoir":false,"auteur":{"nom":"Paul Durand","qualite":"IDE"},"cree_le":"2026-10-22T19:24:38.301927+00:00","relu":{"par":"Claire Martin","le":"2026-10-14T16:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-10-14","revision_le":"2027-10-14"},"motif_refus":null,"vues":1,"utile":1,"mon_vote":false,"reponses":[{"id":"6449efa9-eeaa-439f-8e36-b5d473b8e78b","texte":"Friction hydro-alcoolique avant et après chaque soin, y compris chez le même patient quand on passe d'un site contaminé (change, plaie) à un site propre (injection, cathéter), et après le retrait des gants. Lavage au savon doux seulement si les mains sont visiblement souillées, puis friction une fois les mains sèches.","source":"SF2H, bonnes pratiques en soins de ville, 2015","auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-10-22T19:24:38.301927+00:00","validee":true,"validee_par":"Dr Hélène Marchand, Médecin","validee_le":"2026-10-14"}]},{"id":"774df59b-4388-4c25-85f7-46b0c7e31178","racine_id":"774df59b-4388-4c25-85f7-46b0c7e31178","version":1,"type":"document","titre":"Bonnes pratiques essentielles en hygiène en soins de ville","resume":null,"corps":{"url":"https://www.sf2h.net/k-stock/data/uploads/2015/11/SF2H_recommandations_bonnes-pratiques-essentielles-en-hygiene-a-l-usage-des-professionnels-de-sante-en-soins-de-ville-2015.pdf"},"source":"SF2H, 2015","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène"],"essentiel":false,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-10-22T19:24:38.301927+00:00","relu":{"par":"Claire Martin","le":"2026-10-02T16:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-10-02","revision_le":"2027-10-02"},"motif_refus":null,"vues":1,"utile":0,"mon_vote":false,"reponses":[]},{"id":"7d896f09-9f90-4d72-b9aa-e78b4e88a4b5","racine_id":"7d896f09-9f90-4d72-b9aa-e78b4e88a4b5","version":1,"type":"document","titre":"Hygiène de