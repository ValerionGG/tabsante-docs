{"fiche":"PERFUSION_IV","contenus":[{"id":"5fff5a2b-9a0a-4de8-a57c-e9f06d45c4d8","racine_id":"5fff5a2b-9a0a-4de8-a57c-e9f06d45c4d8","version":1,"type":"geste","titre":"Friction hydro-alcoolique des mains","resume":"Avant et après chaque soin, après le retrait des gants.","corps":{"etapes":[{"texte":"Retirer bagues, montre et bracelets ; ongles courts, sans vernis.","vigilance":null},{"texte":"Déposer une dose de solution hydro-alcoolique qui remplit le creux de la main.","vigilance":"Mains visiblement souillées : lavage au savon doux d'abord, séchage complet, puis friction."},{"texte":"Frictionner paume contre paume, puis le dos de chaque main, doigts entrecroisés.","vigilance":null},{"texte":"Frictionner le dos des doigts, les pouces, puis le bout des doigts et les ongles dans la paume opposée.","vigilance":null},{"texte":"Terminer par les poignets ; frictionner jusqu'à séchage complet, sans essuyer.","vigilance":"Une friction trop courte (moins de 20 à 30 secondes) laisse des zones non désinfectées."}],"materiel":["Solution hydro-alcoolique (flacon de poche)"]},"source":"Contenu de démonstration · à valider par un référent","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène","geste important"],"essentiel":true,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-11-18T07:42:38.986047+00:00","relu":{"par":"Dr Jean Marchand","le":"2026-11-10T17:00:00+00:00"},"validation":{"par":"Dr Jean Marchand","qualite":"Médecin","le":"2026-11-10","revision_le":"2027-11-10"},"motif_refus":null,"vues":4,"utile":2,"mon_vote":true,"reponses":[]},{"id":"0b6f035f-4f94-4d75-8ab2-06572d565256","racine_id":"0b6f035f-4f94-4d75-8ab2-06572d565256","version":1,"type":"video","titre":"La friction hydro-alcoolique, comment ?","resume":null,"corps":{"duree":"1:30","credit":"Hôpitaux u