[{"id":"0963ea50-61f5-477c-b8e5-8db3038032fb","racine_id":"0963ea50-61f5-477c-b8e5-8db3038032fb","version":1,"type":"question","titre":"Quand appeler le médecin pour une plaie ?","resume":null,"corps":{},"source":"Contenu de démonstration · à valider par un référent","fiches":["PANSEMENT"],"tags":["plaie","urgence"],"essentiel":true,"statut":"publie","a_revoir":false,"auteur":{"nom":"Paul Durand","qualite":"IDE"},"cree_le":"2026-10-22T19:24:38.301927+00:00","relu":{"par":"Claire Martin","le":"2026-10-16T16:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-10-16","revision_le":"2027-10-16"},"motif_refus":null,"vues":0,"utile":2,"mon_vote":true,"reponses":[{"id":"d3c3315f-f225-4590-983e-518004a96e6d","texte":"Le jour même devant une rougeur ou une chaleur qui s'étend autour de la plaie, un écoulement purulent ou une odeur nouvelle, une fièvre, une douleur qui augmente, un saignement qui ne cède pas à dix minutes de compression. Sans urgence, signalez une plaie qui ne progresse pas sur deux semaines de pansements. Malaise, confusion ou frissons : appel du 15.","source":null,"auteur":{"nom":"Dr Hélène Marchand","qualite":"Médecin"},"cree_le":"2026-10-22T19:24:38.301927+00:00","validee":true,"validee_par":"Claire Martin, IDE","validee_le":"2026-10-16"}]},{"id":"e2c4ad87-d2af-4a0a-b85d-0760f2557d49","racine_id":"e2c4ad87-d2af-4a0a-b85d-0760f2557d49","version":1,"type":"question","titre":"Saignement chez un patient sous anticoagulant injectable : que faire ?","resume":null,"corps":{},"source":"Contenu de démonstration · à valider par un référent","fiches":["ANTICOAGULANT"],"tags":["anticoagulants","urgence"],"essentiel":true,"statut":"publie","a_revoir":false,"auteur":{"nom":"Paul Durand","qualite":"IDE"},"cree_le":"2026-10-22T19:24:38.301927+00:00","relu":{"par":"Claire Martin","le":"2026-10-15T16:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-10-15","revision_le":"2027-10-15"},"motif_refus":null,"vues":0,"utile":0,"mon_vote":false,"reponses":[{"id":"69899813-5966-47a3-9d53-7105b9c09986","texte":"Saignement minime (point d'injection, gencives, ecchymose isolée) : compression, surveillance, information du médecin dans la journée et traçabilité. Saignement abondant ou qui ne s'arrête pas, sang dans les urines, selles noires, vomissements sanglants, malaise ou maux de tête brutaux : appel du 15. Ne pas administrer la dose suivante sans avis médical en cas de saignement inexpliqué.","source":"OMEDIT Normandie, guide de poche anticoagulants 2024","auteur":{"nom":"Dr Hélène Marchand","qualite":"Médecin"},"cree_le":"2026-10-22T19:24:38.301927+00:00","validee":true,"validee_par":"Claire Martin, IDE","validee_le":"2026-10-15"}]},{"id":"ecf10190-36dc-496b-86e0-7ac4a8892e64","racine_id":"ecf10190-36dc-496b-86e0-7ac4a8892e64","version":1,"type":"geste","titre":"Friction hydro-alcoolique des mains","resume":"Avant et après chaque soin, après le retrait des gants.","corps":{"etapes":[{"texte":"Retirer bagues, montre et bracelets ; ongles courts, sans vernis.","vigilance":null},{"texte":"Déposer une dose de solution hydro-alcoolique qui remplit le creux de la main.","vigilance":"Mains visiblement souillées : lavage au savon doux d'abord, séchage complet, puis friction."},{"texte":"Frictionner paume contre paume, puis le dos de chaque main, doigts entrecroisés.","vigilance":null},{"texte":"Frictionner le dos des doigts, les pouces, puis le bout des doigts et les ongles dans la paume opposée.","vigilance":null},{"texte":"Terminer par les poignets ; frictionner jusqu'à séchage complet, sans essuyer.","vigilance":"Une friction trop courte (moins de 20 à 30 secondes) laisse des zones non désinfectées."}],"materiel":["Solution hydro-alcoolique (flacon de poche)"]},"source":"Contenu de démonstration · à valider par un référent","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène","geste important"],"essentiel":true,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-10-22T19:24:38.301927+00:00","relu":{"par":"Dr Hélène Marchand","le":"2026-10-14T16:00:00+00:00"},"validation":{"par":"Dr Hélène Marchand","qualite":"Médecin","le":"2026-10-14","revision_le":"2027-10-14"},"motif_refus":null,"vues":3,"utile":2,"mon_vote":true,"reponses":[]},{"id":"b6e7076d-d519-455f-bf63-0432b1613ae3","racine_id":"b6e7076d-d519-455f-bf63-0432b1613ae3","version":1,"type":"geste","titre":"Rotation des sites d'injection sous-cutanée","resume":"Changer de site à chaque injection et le tracer.","corps":{"etapes":[{"texte":"Vérifier l'identité du patient, la prescription, le produit, la dose et l'heure prévue.","vigilance":null},{"texte":"Relire le site de la dernière injection tracé au passage précédent.","vigilance":null},{"texte":"Choisir une autre zone : abdomen à distance de l'ombilic et des cicatrices, face externe des cuisses ou des bras, selon le produit.","vigilance":"Ne pas injecter dans un hématome, une zone indurée, cicatricielle ou une lipodystrophie."},{"texte":"HBPM en seringue pré-remplie : ne pas purger la bulle d'air ; pli cutané maintenu pendant toute l'injection, aiguille perpendiculaire.","vigilance":null},{"texte":"Ne pas masser après l'injection ; observer le point de ponction.","vigilance":null},{"texte":"Tracer le site et le côté dans le passage.","vigilance":null}],"materiel":["Seringue ou stylo prescrit","Compresses","Antiseptique selon protocole","Collecteur à aiguilles"]},"source":"Contenu de démonstration · à valider par un référent","fiches":["INJECTION","ANTICOAGULANT","SUIVI_DIABETIQUE"],"tags":["injection","geste important"],"essentiel":true,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-10-22T19:24:38.301927+00:00","relu":{"par":"Dr Hélène Marchand","le":"2026-10-13T16:00:00+00:00"},"validation":{"par":"Dr Hélène Marchand","qualite":"Médecin","le":"2026-10-13","revision_le":"2027-10-13"},"motif_refus":null,"vues":3,"utile":1,"mon_vote":false,"reponses":[]},{"id":"8930bbd8-498c-48c9-a5f5-263739a7f8f8","racine_id":"8930bbd8-498c-48c9-a5f5-263739a7f8f8","version":1,"type":"geste","titre":"Hypoglycémie : conduite à tenir selon le protocole médical","resume":"Le seuil et le resucrage sont ceux du protocole écrit par le médecin du patient.","corps":{"etapes":[{"texte":"Reconnaître les signes : sueurs, tremblements, pâleur, faim, confusion, comportement inhabituel.","vigilance":null},{"texte":"Contrôler la glycémie capillaire et la comparer au seuil fixé par le protocole.","vigilance":null},{"texte":"Patient conscient et capable d'avaler : appliquer le resucrage prévu au protocole.","vigilance":"Ne jamais faire boire ni manger un patient somnolent ou qui avale mal : risque de fausse route."},{"texte":"Recontrôler la glycémie après le délai indiqué au protocole ; renouveler le resucrage si besoin.","vigilance":null},{"texte":"Ne pas injecter l'insuline prévue sans avis médical tant que la glycémie reste sous le seuil.","vigilance":"Troubles de la conscience, convulsions ou absence de réponse au resucrage : appeler le 15."},{"texte":"Tracer valeurs, heures et resucrage ; informer le médecin traitant.","vigilance":null}],"materiel":["Lecteur de glycémie et bandelettes","Sucre ou boisson sucrée selon le protocole"]},"source":"Contenu de démonstration · à valider par un référent","fiches":["SUIVI_DIABETIQUE"],"tags":["urgence","diabète","geste important"],"essentiel":true,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-10-22T19:24:38.301927+00:00","relu":{"par":"Dr Hélène Marchand","le":"2026-10-12T16:00:00+00:00"},"validation":{"par":"Dr Hélène Marchand","qualite":"Médecin","le":"2026-10-12","revision_le":"2027-10-12"},"motif_refus":null,"vues":3,"utile":3,"mon_vote":true,"reponses":[]},{"id":"4d52f941-6f8b-44b7-beca-1d26aefeae17","racine_id":"4d52f941-6f8b-44b7-beca-1d26aefeae17","version":1,"type":"geste","titre":"Prélèvement veineux à domicile : bonnes pratiques","resume":"De l'identification du patient au dépôt au laboratoire.","corps":{"etapes":[{"texte":"Vérifier l'identité du patient et l'ordonnance ; contrôler les conditions demandées (à jeun, horaire, traitement pris ou non).","vigilance":null},{"texte":"Préparer les tubes du laboratoire destinataire et vérifier leur date de péremption.","vigilance":null},{"texte":"Hygiène des mains, garrot posé moins d'une minute, antisepsie du point de ponction.","vigilance":null},{"texte":"Remplir les tubes dans l'ordre recommandé par le laboratoire ; retourner doucement chaque tube.","vigilance":null},{"texte":"Étiqueter les tubes au domicile, devant le patient, avant de partir.","vigilance":"Un tube non étiqueté ou mal identifié est refusé : jamais d'étiquetage différé dans la voiture."},{"texte":"Compléter la fiche de prélèvement (heure, préleveur) ; respecter délai et température de transport.","vigilance":"Délai et température d'acheminement : se référer au manuel de prélèvement du laboratoire."}],"materiel":["Tubes et corps de prélèvement","Garrot","Antiseptique et compresses","Collecteur à aiguilles","Boîte de transport"]},"source":"Contenu de démonstration · à valider par un référent","fiches":["PRELEVEMENT"],"tags":["pré-analytique","geste important"],"essentiel":true,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-10-22T19:24:38.301927+00:00","relu":{"par":"Dr Hélène Marchand","le":"2026-10-11T16:00:00+00:00"},"validation":{"par":"Dr Hélène Marchand","qualite":"Médecin","le":"2026-10-11","revision_le":"2027-10-11"},"motif_refus":null,"vues":3,"utile":3,"mon_vote":true,"reponses":[]},{"id":"a30b6044-0ef2-4975-b0a7-46cb6f11105f","racine_id":"a30b6044-0ef2-4975-b0a7-46cb6f11105f","version":1,"type":"video","titre":"La friction hydro-alcoolique, comment ?","resume":null,"corps":{"duree":"1:30","credit":"Hôpitaux universitaires de Genève · lue depuis YouTube, droits réservés à son auteur","youtube_id":"IXiGWkMu27E"},"source":"Hôpitaux universitaires de Genève","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène","geste important"],"essentiel":true,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-10-22T19:24:38.301927+00:00","relu":{"par":"Claire Martin","le":"2026-10-10T16:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-10-10","revision_le":"2027-10-10"},"motif_refus":null,"vues":0,"utile":1,"mon_vote":false,"reponses":[]},{"id":"ee2ffbc9-de99-4138-aea5-a14ea47cccef","racine_id":"ee2ffbc9-de99-4138-aea5-a14ea47cccef","version":1,"type":"video","titre":"PICC à domicile : la réfection du pansement","resume":null,"corps":{"duree":"8:16","credit":"CPias Occitanie · lue depuis YouTube, droits réservés à son auteur","youtube_id":"mTLwZxwnsGU"},"source":"CPias Occitanie","fiches":["PERFUSION_IV"],"tags":["picc","hygiène","geste important"],"essentiel":true,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-10-22T19:24:38.301927+00:00","relu":{"par":"Claire Martin","le":"2026-10-01T16:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-10-01","revision_le":"2027-10-01"},"motif_refus":null,"vues":0,"utile":1,"mon_vote":false,"reponses":[]},{"id":"5bf6f706-3a4a-45ed-b325-5b3bfc2e0457","racine_id":"5bf6f706-3a4a-45ed-b325-5b3bfc2e0457","version":1,"type":"video","titre":"Sécuriser les soins sur chambres à cathéter implantable au domicile","resume":null,"corps":{"duree":"10:03","credit":"CPias Nouvelle-Aquitaine · lue depuis YouTube, droits réservés à son auteur","youtube_id":"mYoN3fpiCYU"},"source":"CPias Nouvelle-Aquitaine","fiches":["PERFUSION_IV"],"tags":["chambre implantable","hygiène","geste important"],"essentiel":true,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-10-22T19:24:38.301927+00:00","relu":{"par":"Claire Martin","le":"2026-09-19T16:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-09-19","revision_le":"2027-09-19"},"motif_refus":null,"vues":0,"utile":3,"mon_vote":true,"reponses":[]},{"id":"be77bf8d-1b10-4a51-8ab6-309c80bdc02e","racine_id":"be77bf8d-1b10-4a51-8ab6-309c80bdc02e","version":1,"type":"video","titre":"Les bonnes pratiques du prélèvement biologique","resume":null,"corps":{"duree":"5:51","credit":"CHA · lue depuis YouTube, droits réservés à son auteur","youtube_id":"6hah8g_MN68"},"source":"CHA","fiches":["PRELEVEMENT"],"tags":["pré-analytique","geste important"],"essentiel":true,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-10-22T19:24:38.301927+00:00","relu":{"par":"Claire Martin","le":"2026-09-16T16:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-09-16","revision_le":"2027-09-16"},"motif_refus":null,"vues":0,"utile":3,"mon_vote":true,"reponses":[]},{"id":"87136e3b-1438-414f-95b4-67028a05b5dd","racine_id":"87136e3b-1438-414f-95b4-67028a05b5dd","version":1,"type":"question","titre":"Faut-il purger la bulle d'air d'une seringue pré-remplie d'HBPM ?","resume":null,"corps":{},"source":"Contenu de démonstration · à valider par un référent","fiches":["ANTICOAGULANT","INJECTION"],"tags":["injection","hbpm"],"essentiel":false,"statut":"publie","a_revoir":false,"auteur":{"nom":"Paul Durand","qualite":"IDE"},"cree_le":"2026-10-22T19:24:38.301927+00:00","relu":{"par":"Claire Martin","le":"2026-10-17T16:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-10-17","revision_le":"2027-10-17"},"motif_refus":null,"vues":0,"utile":3,"mon_vote":true,"reponses":[{"id":"e24f21a6-082a-4954-9c62-de9a39c892a2","texte":"Non. La bulle d'air des seringues pré-remplies d'HBPM ne se purge pas : elle évite la perte de produit et limite l'hématome au point d'injection. Seule exception : un ajustement de dose prévu par la prescription, en suivant la notice du produit.","source":"OMEDIT Normandie, guide de poche anticoagulants 2024","auteur":{"nom":"Dr Hélène Marchand","qualite":"Médecin"},"cree_le":"2026-10-22T19:24:38.301927+00:00","validee":true,"validee_par":"Claire Martin, IDE","validee_le":"2026-10-17"}]},{"id":"dee29995-8836-4fca-b529-7e3f818fa47d","racine_id":"dee29995-8836-4fca-b529-7e3f818fa47d","version":1,"type":"question","titre":"Quelle hygiène des mains entre deux soins chez le même patient ?","resume":null,"corps":{},"source":"Contenu de démonstration · à valider par un référent","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène"],"essentiel":false,"statut":"publie","a_revoir":false,"auteur":{"nom":"Paul Durand","qualite":"IDE"},"cree_le":"2026-10-22T19:24:38.301927+00:00","relu":{"par":"Claire Martin","le":"2026-10-14T16:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-10-14","revision_le":"2027-10-14"},"motif_refus":null,"vues":0,"utile":1,"mon_vote":false,"reponses":[{"id":"6449efa9-eeaa-439f-8e36-b5d473b8e78b","texte":"Friction hydro-alcoolique avant et après chaque soin, y compris chez le même patient quand on passe d'un site contaminé (change, plaie) à un site propre (injection, cathéter), et après le retrait des gants. Lavage au savon doux seulement si les mains sont visiblement souillées, puis friction une fois les mains sèches.","source":"SF2H, bonnes pratiques en soins de ville, 2015","auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-10-22T19:24:38.301927+00:00","validee":true,"validee_par":"Dr Hélène Marchand, Médecin","validee_le":"2026-10