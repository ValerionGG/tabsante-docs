{"fiche":"ANTICOAGULANT","contenus":[{"id":"5fff5a2b-9a0a-4de8-a57c-e9f06d45c4d8","racine_id":"5fff5a2b-9a0a-4de8-a57c-e9f06d45c4d8","version":1,"type":"geste","titre":"Friction hydro-alcoolique des mains","resume":"Avant et après chaque soin, après le retrait des gants.","corps":{"etapes":[{"texte":"Retirer bagues, montre et bracelets ; ongles courts, sans vernis.","vigilance":null},{"texte":"Déposer une dose de solution hydro-alcoolique qui remplit le creux de la main.","vigilance":"Mains visiblement souillées : lavage au savon doux d'abord, séchage complet, puis friction."},{"texte":"Frictionner paume contre paume, puis le dos de chaque main, doigts entrecroisés.","vigilance":null},{"texte":"Frictionner le dos des doigts, les pouces, puis le bout des doigts et les ongles dans la paume opposée.","vigilance":null},{"texte":"Terminer par les poignets ; frictionner jusqu'à séchage complet, sans essuyer.","vigilance":"Une friction trop courte (moins de 20 à 30 secondes) laisse des zones non désinfectées."}],"materiel":["Solution hydro-alcoolique (flacon de poche)"]},"source":"Contenu de démonstration · à valider par un référent","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène","geste important"],"essentiel":true,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-11-18T07:42:38.986047+00:00","relu":{"par":"Dr Jean Marchand","le":"2026-11-10T17:00:00+00:00"},"validation":{"par":"Dr Jean Marchand","qualite":"Médecin","le":"2026-11-10","revision_le":"2027-11-10"},"motif_refus":null,"vues":4,"utile":2,"mon_vote":true,"reponses":[]},{"id":"bdcb2a2d-b9c6-46b9-b6b9-4d7d7fffbdba","racine_id":"bdcb2a2d-b9c6-46b9-b6b9-4d7d7fffbdba","version":1,"type":"geste","titre":"Rotation des sites d'injection sous-cutanée","resume":"Changer de site à chaque injection et le tracer.","corps":{"etapes":[{"texte":"Vérifier l'identité du patient, la prescription, le produit, la dose et l'heure prévue.","vigilance":null},{"texte":"Relire le site de la dernière injection tracé au passage précédent.","vigilance":null},{"texte":"Choisir une autre zone : abdomen à distance de l'ombilic et des cicatrices, face externe des cuisses ou des bras, selon le produit.","vigilance":"Ne pas injecter dans un hématome, une zone indurée, cicatricielle ou une lipodystrophie."},{"texte":"HBPM en seringue pré-remplie : ne pas purger la bulle d'air ; pli cutané maintenu pendant toute l'injection, aiguille perpendiculaire.","vigilance":null},{"texte":"Ne pas masser après l'injection ; observer le point de ponction.","vigilance":null},{"texte":"Tracer le site et le côté dans le passage.","vigilance":null}],"materiel":["Seringue ou stylo prescrit","Compresses","Antiseptique selon protocole","Collecteur à aiguilles"]},"source":"Contenu de démonstration · à valider par un référent","fiches":["INJECTION","ANTICOAGULANT","SUIVI_DIABETIQUE"],"tags":["injection","geste important"],"essentiel":true,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-11-18T07:42:38.986047+00:00","relu":{"par":"Dr Jean Marchand","le":"2026-11-09T17:00:00+00:00"},"validation":{"par":"Dr Jean Marchand","qualite":"Médecin","le":"2026-11-09","revision_le":"2027-11-09"},"motif_refus":null,"vues":4,"utile":1,"mon_vote":true,"reponses":[]},{"id":"0b6f035f-4f94-4d75-8ab2-06572d565256","racine_id":"0b6f035f-4f94-4d75-8ab2-06572d565256","version":1,"type":"video","titre":"La friction hydro-alcoolique, comment ?","resume":null,"corps":{"duree":"1:30","credit":"Hôpitaux universitaires de Genève · lue depuis YouTube, droits réservés à son auteur","youtube_id":"IXiGWkMu27E"},"source":"Hôpitaux universitaires de Genève","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène","geste important"],"essentiel":true,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-11-18T07:42:38.986047+00:00","relu":{"par":"Claire Martin","le":"2026-11-06T17:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-11-06","revision_le":"2027-11-06"},"motif_refus":null,"vues":0,"utile":1,"mon_vote":true,"reponses":[]},{"id":"a56dad46-10da-4c5b-b8be-1755894afff1","racine_id":"a56dad46-10da-4c5b-b8be-1755894afff1","version":1,"type":"question","titre":"Saignement chez un patient sous anticoagulant injectable : que faire ?","resume":null,"corps":{},"source":"Contenu de démonstration · à valider par un référent","fiches":["ANTICOAGULANT"],"tags":["anticoagulants","urgence"],"essentiel":true,"statut":"publie","a_revoir":false,"auteur":{"nom":"Paul Durand","qualite":"IDE"},"cree_le":"2026-11-18T07:42:38.986047+00:00","relu":{"par":"Claire Martin","le":"2026-11-11T17:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-11-11","revision_le":"2027-11-11"},"motif_refus":null,"vues":0,"utile":0,"mon_vote":false,"reponses":[{"id":"1f86c3e3-398c-4912-b38c-ed4fd54fb96a","texte":"Saignement minime (point d'injection, gencives, ecchymose isolée) : compression, surveillance, information du médecin dans la journée et traçabilité. Saignement abondant ou qui ne s'arrête pas, sang dans les urines, selles noires, vomissements sanglants, malaise ou maux de tête brutaux : appel du 15. Ne pas administrer la dose suivante sans avis médical en cas de saignement inexpliqué.","source":"OMEDIT Normandie, guide de poche anticoagulants 2024","auteur":{"nom":"Dr Jean Marchand","qualite":"Médecin"},"cree_le":"2026-11-18T07:42:38.986047+00:00","validee":true,"validee_par":"Claire Martin, IDE","validee_le":"2026-11-11"}]},{"id":"e63cba94-dc21-4487-9acd-c8d075bfe1da","racine_id":"e63cba94-dc21-4487-9acd-c8d075bfe1da","version":1,"type":"video","titre":"Désinfection des mains par friction hydro-alcoolique","resume":null,"corps":{"duree":"1:05","credit":"Gustave Roussy · lue depuis YouTube, droits réservés à son auteur","youtube_id":"_MtZJsdr824"},"source":"Gustave Roussy","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène"],"essentiel":false,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-11-18T07:42:38.986047+00:00","relu":{"par":"Claire Martin","le":"2026-11-03T17:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-11-03","revision_le":"2027-11-03"},"motif_refus":null,"vues":0,"utile":1,"mon_vote":true,"reponses":[]},{"id":"21ad15db-0953-4c2a-ba68-d4a4ad53e033","racine_id":"21ad15db-0953-4c2a-ba68-d4a4ad53e033","version":1,"type":"video","titre":"La désinfection des mains par friction hydro-alcoolique","resume":null,"corps":{"duree":"2:00","credit":"Hôpital universitaire Robert-Debré · lue depuis YouTube, droits réservés à son auteur","youtube_id":"KFK7f8IMGe8"},"source":"Hôpital universitaire Robert-Debré","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène"],"essentiel":false,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-11-18T07:42:38.986047+00:00","relu":{"par":"Claire Martin","le":"2026-10-31T17:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-10-31","revision_le":"2027-10-31"},"motif_refus":null,"vues":0,"utile":2,"mon_vote":true,"reponses":[]},{"id":"3e25c7aa-6973-46eb-bb00-941f36fd2339","racine_id":"3e25c7aa-6973-46eb-bb00-941f36fd2339","version":1,"type":"question","titre":"Faut-il purger la bulle d'air d'une seringue pré-remplie d'HBPM ?","resume":null,"corps":{},"source":"Contenu de démonstration · à valider par un référent","fiches":["ANTICOAGULANT","INJECTION"],"tags":["injection","hbpm"],"essentiel":false,"statut":"publie","a_revoir":false,"auteur":{"nom":"Paul Durand","qualite":"IDE"},"cree_le":"2026-11-18T07:42:38.986047+00:00","relu":{"par":"Claire Martin","le":"2026-11-13T17:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-11-13","revision_le":"2027-11-13"},"motif_refus":null,"vues":0,"utile":3,"mon_vote":true,"reponses":[{"id":"15ed3dfc-9330-4875-9d92-29e2d80771e5","texte":"Non. La bulle d'air des seringues pré-remplies d'HBPM ne se purge pas : elle évite la perte de produit et limite l'hématome au point d'injection. Seule exception : un ajustement de dose prévu par la prescription, en suivant la notice du produit.","source":"OMEDIT Normandie, guide de poche anticoagulants 2024","auteur":{"nom":"Dr Jean Marchand","qualite":"Médecin"},"cree_le":"2026-11-18T07:42:38.986047+00:00","validee":true,"validee_par":"Claire Martin, IDE","validee_le":"2026-11-13"}]},{"id":"eaf0da53-6184-42bd-b820-0ff9343cf1ac","racine_id":"eaf0da53-6184-42bd-b820-0ff9343cf1ac","version":1,"type":"question","titre":"Quelle hygiène des mains entre deux soins chez le même patient ?","resume":null,"corps":{},"source":"Contenu de démonstration · à valider par un référent","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène"],"essentiel":false,"statut":"publie","a_revoir":false,"auteur":{"nom":"Paul Durand","qualite":"IDE"},"cree_le":"2026-11-18T07:42:38.986047+00:00","relu":{"par":"Claire Martin","le":"2026-11-10T17:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-11-10","revision_le":"2027-11-10"},"motif_refus":null,"vues":0,"utile":1,"mon_vote":true,"reponses":[{"id":"6637fc75-1ca9-47c7-b4f5-f3ba766ae466","texte":"Friction hydro-alcoolique avant et après chaque soin, y compris chez le même patient quand on passe d'un site contaminé (change, plaie) à un site propre (injection, cathéter), et après le retrait des gants. Lavage au savon doux seulement si les mains sont visiblement souillées, puis friction une fois les mains sèches.","source":"SF2H, bonnes pratiques en soins de ville, 2015","auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-11-18T07:42:38.986047+00:00","validee":true,"validee_par":"Dr Jean Marchand, Médecin","validee_le":"2026-11-10"}]},{"id":"c65ad79f-a5e3-40bb-9e0c-9b9bf6c774e3","racine_id":"c65ad79f-a5e3-40bb-9e0c-9b9bf6c774e3","version":1,"type":"document","titre":"Anticoagulants : boîte à outils","resume":null,"corps":{"url":"https://www.omedit-paysdelaloire.fr/boite-a-outils/medicaments/anticoagulants/"},"source":"OMEDIT Pays de la Loire","fiches":["ANTICOAGULANT"],"tags":["anticoagulants"],"essentiel":false,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-11-18T07:42:38.986047+00:00","relu":{"par":"Claire Martin","le":"2026-10-19T16:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-10-19","revision_le":"2027-10-19"},"motif_refus":null,"vues":0,"utile":1,"mon_vote":true,"reponses":[]},{"id":"64d9adec-b249-4120-85bb-c3cadffb35e0","racine_id":"64d9adec-b249-4120-85bb-c3cadffb35e0","version":1,"type":"document","titre":"Bonnes pratiques essentielles en hygiène en soins de ville","resume":null,"corps":{"url":"https://www.sf2h.net/k-stock/data/uploads/2015/11/SF2H_recommandations_bonnes-pratiques-essentielles-en-hygiene-a-l-usage-des-professionnels-de-sante-en-soins-de-ville-2015.pdf"},"source":"SF2H, 2015","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène"],"essentiel":false,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-11-18T07:42:38.986047+00:00","relu":{"par":"Claire Martin","le":"2026-10-29T17:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-10-29","revision_le":"2027-10-29"},"motif_refus":null,"vues":0,"utile":0,"mon_vote":false,"reponses":[]},{"id":"b3bc5097-883f-4b95-a52c-4e83a8ad3ccf","racine_id":"b3bc5097-883f-4b95-a52c-4e83a8ad3ccf","version":1,"type":"document","titre":"Guide de poche anticoagulants","resume":null,"corps":{"url":"https://www.omedit-normandie.fr/media-files/42806/guide-de-poche-anticoagulants-v18_07_2024.pdf"},"source":"OMEDIT Normandie, 2024","fiches":["ANTICOAGULANT"],"tags":["anticoagulants"],"essentiel":false,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-11-18T07:42:38.986047+00:00","relu":{"par":"Claire Martin","le":"2026-10-21T16:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-10-21","revision_le":"2027-10-21"},"motif_refus":null,"vues":0,"utile":1,"mon_vote":true,"reponses":[]},{"id":"ca812c1b-2313-458f-bce0-f26c5a4ebfd2","racine_id":"ca812c1b-2313-458f-bce0-f26c5a4ebfd2","version":1,"type":"document","titre":"Hygiène des mains","resume":null,"corps":{"url":"https://www.sf2h.net/publications/hygiene-des-mains.html"},"source":"SF2H","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène"],"essentiel":false,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-11-18T07:42:38.986047+00:00","relu":{"par":"Claire Martin","le":"2026-10-27T17:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-10-27","revision_le":"2027-10-27"},"motif_refus":null,"vues":0,"utile":0,"mon_vote":false,"reponses":[]}