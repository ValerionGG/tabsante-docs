{"fiche":"INJECTION","contenus":[{"id":"6c284975-2c82-4a27-80c2-be037a92057e","racine_id":"6c284975-2c82-4a27-80c2-be037a92057e","version":1,"type":"geste","titre":"Friction hydro-alcoolique des mains","resume":"Avant et après chaque soin, après le retrait des gants.","corps":{"etapes":[{"texte":"Retirer bagues, montre et bracelets ; ongles courts, sans vernis.","vigilance":null},{"texte":"Déposer une dose de solution hydro-alcoolique qui remplit le creux de la main.","vigilance":"Mains visiblement souillées : lavage au savon doux d'abord, séchage complet, puis friction."},{"texte":"Frictionner paume contre paume, puis le dos de chaque main, doigts entrecroisés.","vigilance":null},{"texte":"Frictionner le dos des doigts, les pouces, puis le bout des doigts et les ongles dans la paume opposée.","vigilance":null},{"texte":"Terminer par les poignets ; frictionner jusqu'à séchage complet, sans essuyer.","vigilance":"Une friction trop courte (moins de 20 à 30 secondes) laisse des zones non désinfectées."}],"materiel":["Solution hydro-alcoolique (flacon de poche)"]},"source":"Contenu de démonstration · à valider par un référent","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène","geste important"],"essentiel":true,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-11-18T07:40:12.505155+00:00","relu":{"par":"Dr Jean Marchand","le":"2026-11-10T17:00:00+00:00"},"validation":{"par":"Dr Jean Marchand","qualite":"Médecin","le":"2026-11-10","revision_le":"2027-11-10"},"motif_refus":null,"vues":4,"utile":2,"mon_vote":false,"reponses":[]},{"id":"80ad00a7-fdc5-4adc-82a0-cd5bb9b021bc","racine_id":"80ad00a7-fdc5-4adc-82a0-cd5bb9b021bc","version":1,"type":"geste","titre":"Rotation des sites d'injection sous-cutanée","resume":"Changer de site à chaque injection et le tracer.","corps":{"etapes":[{"texte":"Vérifier l'identité du patient, la prescription, le produit, la dose et l'heure prévue.","vigilance":null},{"texte":"Relire le site de la dernière injection tracé au passage précédent.","vigilance":null},{"texte":"Choisir une autre zone : abdomen à distance de l'ombilic et des cicatrices, face externe des cuisses ou des bras, selon le produit.","vigilance":"Ne pas injecter dans un hématome, une zone indurée, cicatricielle ou une lipodystrophie."},{"texte":"HBPM en seringue pré-remplie : ne pas purger la bulle d'air ; pli cutané maintenu pendant toute l'injection, aiguille perpendiculaire.","vigilance":null},{"texte":"Ne pas masser après l'injection ; observer le point de ponction.","vigilance":null},{"texte":"Tracer le site et le côté dans le passage.","vigilance":null}],"materiel":["Seringue ou stylo prescrit","Compresses","Antiseptique selon protocole","Collecteur à aiguilles"]},"source":"Contenu de démonstration · à valider par un référent","fiches":["INJECTION","ANTICOAGULANT","SUIVI_DIABETIQUE"],"tags":["injection","geste important"],"essentiel":true,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-11-18T07:40:12.505155+00:00","relu":{"par":"Dr Jean Marchand","le":"2026-11-09T17:00:00+00:00"},"validation":{"par":"Dr Jean Marchand","qualite":"Médecin","le":"2026-11-09","revision_le":"2027-11-09"},"motif_refus":null,"vues":4,"utile":1,"mon_vote":false,"reponses":[]},{"id":"ef0919cb-8b71-4d3c-9460-127fb50a8452","racine_id":"ef0919cb-8b71-4d3c-9460-127fb50a8452","version":1,"type":"video","titre":"La friction hydro-alcoolique, comment ?","resume":null,"corps":{"duree":"1:30","credit":"Hôpitaux universitaires de Genève · lue depuis YouTube, droits réservés à son auteur","youtube_id":"IXiGWkMu27E"},"source":"Hôpitaux universitaires de Genève","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène","geste important"],"essentiel":true,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-11-18T07:40:12.505155+00:00","relu":{"par":"Claire Martin","le":"2026-11-06T17:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-11-06","revision_le":"2027-11-06"},"motif_refus":null,"vues":2,"utile":1,"mon_vote":false,"reponses":[]},{"id":"8f3397b8-539a-4991-b6e5-a35a89489c5c","racine_id":"8f3397b8-539a-4991-b6e5-a35a89489c5c","version":1,"type":"video","titre":"Désinfection des mains par friction hydro-alcoolique","resume":null,"corps":{"duree":"1:05","credit":"Gustave Roussy · lue depuis YouTube, droits réservés à son auteur","youtube_id":"_MtZJsdr824"},"source":"Gustave Roussy","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène"],"essentiel":false,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-11-18T07:40:12.505155+00:00","relu":{"par":"Claire Martin","le":"2026-11-03T17:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-11-03","revision_le":"2027-11-03"},"motif_refus":null,"vues":2,"utile":1,"mon_vote":false,"reponses":[]},{"id":"af544dd3-80aa-4fac-a2b3-4fdbceab1596","racine_id":"af544dd3-80aa-4fac-a2b3-4fdbceab1596","version":1,"type":"video","titre":"La désinfection des mains par friction hydro-alcoolique","resume":null,"corps":{"duree":"2:00","credit":"Hôpital universitaire Robert-Debré · lue depuis YouTube, droits réservés à son auteur","youtube_id":"KFK7f8IMGe8"},"source":"Hôpital universitaire Robert-Debré","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène"],"essentiel":false,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-11-18T07:40:12.505155+00:00","relu":{"par":"Claire Martin","le":"2026-10-31T17:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-10-31","revision_le":"2027-10-31"},"motif_refus":null,"vues":2,"utile":2,"mon_vote":false,"reponses":[]},{"id":"64eb392d-d819-4868-bd2a-3cc1754810ca","racine_id":"64eb392d-d819-4868-bd2a-3cc1754810ca","version":1,"type":"question","titre":"Faut-il purger la bulle d'air d'une seringue pré-remplie d'HBPM ?","resume":null,"corps":{},"source":"Contenu de démonstration · à valider par un référent","fiches":["ANTICOAGULANT","INJECTION"],"tags":["injection","hbpm"],"essentiel":false,"statut":"publie","a_revoir":false,"auteur":{"nom":"Paul Durand","qualite":"IDE"},"cree_le":"2026-11-18T07:40:12.505155+00:00","relu":{"par":"Claire Martin","le":"2026-11-13T17:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-11-13","revision_le":"2027-11-13"},"motif_refus":null,"vues":2,"utile":3,"mon_vote":false,"reponses":[{"id":"9c679e41-96af-400a-8954-d8f6f63736a3","texte":"Non. La bulle d'air des seringues pré-remplies d'HBPM ne se purge pas : elle évite la perte de produit et limite l'hématome au point d'injection. Seule exception : un ajustement de dose prévu par la prescription, en suivant la notice du produit.","source":"OMEDIT Normandie, guide de poche anticoagulants 2024","auteur":{"nom":"Dr Jean Marchand","qualite":"Médecin"},"cree_le":"2026-11-18T07:40:12.505155+00:00","validee":true,"validee_par":"Claire Martin, IDE","validee_le":"2026-11-13"}]},{"id":"e2d38674-e5c2-4093-a2f4-818efc3de515","racine_id":"e2d38674-e5c2-4093-a2f4-818efc3de515","version":1,"type":"question","titre":"Quelle hygiène des mains entre deux soins chez le même patient ?","resume":null,"corps":{},"source":"Contenu de démonstration · à valider par un référent","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène"],"essentiel":false,"statut":"publie","a_revoir":false,"auteur":{"nom":"Paul Durand","qualite":"IDE"},"cree_le":"2026-11-18T07:40:12.505155+00:00","relu":{"par":"Claire Martin","le":"2026-11-10T17:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-11-10","revision_le":"2027-11-10"},"motif_refus":null,"vues":2,"utile":1,"mon_vote":false,"reponses":[{"id":"4c5afebb-e47a-47d3-81ef-81c6d16d2a28","texte":"Friction hydro-alcoolique avant et après chaque soin, y compris chez le même patient quand on passe d'un site contaminé (change, plaie) à un site propre (injection, cathéter), et après le retrait des gants. Lavage au savon doux seulement si les mains sont visiblement souillées, puis friction une fois les mains sèches.","source":"SF2H, bonnes pratiques en soins de ville, 2015","auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-11-18T07:40:12.505155+00:00","validee":true,"validee_par":"Dr Jean Marchand, Médecin","validee_le":"2026-11-10"}]},{"id":"d39f2eed-e700-4a1d-962a-f84e44d02c07","racine_id":"d39f2eed-e700-4a1d-962a-f84e44d02c07","version":1,"type":"document","titre":"Bonnes pratiques essentielles en hygiène en soins de ville","resume":null,"corps":{"url":"https://www.sf2h.net/k-stock/data/uploads/2015/11/SF2H_recommandations_bonnes-pratiques-essentielles-en-hygiene-a-l-usage-des-professionnels-de-sante-en-soins-de-ville-2015.pdf"},"source":"SF2H, 2015","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène"],"essentiel":false,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-11-18T07:40:12.505155+00:00","relu":{"par":"Claire Martin","le":"2026-10-29T17:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-10-29","revision_le":"2027-10-29"},"motif_refus":null,"vues":2,"utile":0,"mon_vote":false,"reponses":[]},{"id":"00627d52-e9d1-48f5-bae4-22407e414f92","racine_id":"00627d52-e9d1-48f5-bae4-22407e414f92","version":1,"type":"document","titre":"Hygiène des mains","resume":null,"corps":{"url":"https://www.sf2h.net/publications/hygiene-des-mains.html"},"source":"SF2H","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène"],"essentiel":false,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-11-18T07:40:12.505155+00:00","relu":{"par":"Claire Martin","le":"2026-10-27T17:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-10-27","revision_le":"2027-10-27"},"motif_refus":null,"vues":2,"utile":0,"mon_vote":false,"reponses":[]}]}