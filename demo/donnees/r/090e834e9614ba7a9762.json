c-4c52-8145-5defbc5a8069","version":1,"type":"video","titre":"Réfection de pansement PICC ou Midline","resume":null,"corps":{"duree":"8:17","credit":"Fondation Santé Service · lue depuis YouTube, droits réservés à son auteur","youtube_id":"B1iX4e6siRA"},"source":"Fondation Santé Service","fiches":["PERFUSION_IV"],"tags":["picc","midline"],"essentiel":false,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-10-23T06:40:11.108151+00:00","relu":{"par":"Claire Martin","le":"2026-09-29T16:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-09-29","revision_le":"2027-09-29"},"motif_refus":null,"vues":0,"utile":0,"mon_vote":false,"reponses":[]},{"id":"5b408314-aee6-4be9-85b6-e488a55263c5","racine_id":"5b408314-aee6-4be9-85b6-e488a55263c5","version":1,"type":"question","titre":"Quelle hygiène des mains entre deux soins chez le même patient ?","resume":null,"corps":{},"source":"Contenu de démonstration · à valider par un référent","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène"],"essentiel":false,"statut":"publie","a_revoir":false,"auteur":{"nom":"Paul Durand","qualite":"IDE"},"cree_le":"2026-10-23T06:40:11.108151+00:00","relu":{"par":"Claire Martin","le":"2026-10-15T16:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-10-15","revision_le":"2027-10-15"},"motif_refus":null,"vues":0,"utile":1,"mon_vote":true,"reponses":[{"id":"4fafbf4f-b20e-40de-b6ca-77c4433aaaca","texte":"Friction hydro-alcoolique avant et après chaque soin, y compris chez le même patient quand on passe d'un site contaminé (change, plaie) à un site propre (injection, cathéter), et après le retrait des gants. Lavage au savon doux seulement si les mains sont visiblement souillées, puis friction une fois les mains sèches.","source":"SF2H, bonnes pratiques en soins de ville, 2015","auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-10-23T06:40:11.108151+00:00","validee":true,"validee_par":"Dr Hélène Marchand, Médecin","validee_le":"2026-10-15"}]},{"id":"85071308-6dad-4a96-85ab-1174b418d06c","racine_id":"85071308-6dad-4a96-85ab-1174b418d06c","version":1,"type":"document","titre":"Bonnes pratiques essentielles en hygiène en soins de ville","resume":null,"corps":{"url":"https://www.sf2h.net/k-stock/data/uploads/2015/11/SF2H_recommandations_bonnes-pratiques-essentielles-en-hygiene-a-l-usage-des-professionnels-de-sante-en-soins-de-ville-2015.pdf"},"source":"SF2H, 2015","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène"],"essentiel":false,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-10-23T06:40:11.108151+00:00","relu":{"par":"Claire Martin","le":"2026-10-03T16:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-10-03","revision_le":"2027-10-03"},"motif_refus":null,"vues":0,"utile":0,"mon_vote":false,"reponses":[]},{"id":"d25ad13c-71df-4eb6-9092-371dc9aca4c6","racine_id":"d25ad13c-71df-4eb6-9092-371dc9aca4c6","version":1,"type":"document","titre":"Hygiène des mains","resume":null,"corps":{"url":"https://www.sf2h.net/publications/hygiene-des-mains.html"},"source":"SF2H","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène"],"essentiel":false,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-10-23T06:40:11.108151+00:00","relu":{"par":"Claire Martin","le":"2026-10-01T16:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-10-0