{"fiche":"MEDICAMENTS","contenus":[{"id":"c9da7526-9a57-494a-acc1-5b56197d2a5e","racine_id":"c9da7526-9a57-494a-acc1-5b56197d2a5e","version":1,"type":"geste","titre":"Friction hydro-alcoolique des mains","resume":"Avant et après chaque soin, après le retrait des gants.","corps":{"etapes":[{"texte":"Retirer bagues, montre et bracelets ; ongles courts, sans vernis.","vigilance":null},{"texte":"Déposer une dose de solution hydro-alcoolique qui remplit le creux de la main.","vigilance":"Mains visiblement souillées : lavage au savon doux d'abord, séchage complet, puis friction."},{"texte":"Frictionner paume contre paume, puis le dos de chaque main, doigts entrecroisés.","vigilance":null},{"texte":"Frictionner le dos des doigts, les pouces, puis le bout des doigts et les ongles dans la paume opposée.","vigilance":null},{"texte":"Terminer par les poignets ; frictionner jusqu'à séchage complet, sans essuyer.","vigilance":"Une friction trop courte (moins de 20 à 30 secondes) laisse des zones non désinfectées."}],"materiel":["Solution hydro-alcoolique (flacon de poche)"]},"source":"Contenu de démonstration · à valider par un référent","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène","geste important"],"essentiel":true,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-10-27T07:40:49.034591+00:00","relu":{"par":"Dr Hélène Marchand","le":"2026-10-19T16:00:00+00:00"},"validation":{"par":"Dr Hélène Marchand","qualite":"Médecin","le":"2026-10-19","revision_le":"2027-10-19"},"motif_refus":null,"vues":4,"utile":2,"mon_vote":false,"reponses":[]},{"id":"ea635aef-e1f8-4afd-b5e8-85f7e9175e9d","racine_id":"ea635aef-e1f8-4afd-b5e8-85f7e9175e9d","version":1,"type":"video","titre":"La friction hydro-alcoolique, comment ?","resume":null,"corps":{"duree":"1:30","credit":"Hôpitaux universitaires de Genève · lue depuis YouTube, droits réservés à son auteur","youtube_id":"IXiGWkMu27E"},"source":"Hôpitaux universitaires de Genève","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène","geste important"],"essentiel":true,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-10-27T07:40:49.034591+00:00","relu":{"par":"Claire Martin","le":"2026-10-15T16:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-10-15","revision_le":"2027-10-15"},"motif_refus":null,"vues":2,"utile":1,"mon_vote":false,"reponses":[]},{"id":"d236e01a-ecc6-4764-a9ac-be89088fbb69","racine_id":"d236e01a-ecc6-4764-a9ac-be89088fbb69","version":1,"type":"video","titre":"Désinfection des mains par friction hydro-alcoolique","resume":null,"corps":{"duree":"1:05","credit":"Gustave Roussy · lue depuis YouTube, droits réservés à son auteur","youtube_id":"_MtZJsdr824"},"source":"Gustave Roussy","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène"],"essentiel":false,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-10-27T07:40:49.034591+00:00","relu":{"par":"Claire Martin","le":"2026-10-12T16:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-10-12","revision_le":"2027-10-12"},"motif_refus":null,"vues":2,"utile":1,"mon_vote":false,"reponses":[]},{"id":"d2b86bd4-ada9-4030-8364-dcab3939e408","racine_id":"d2b86bd4-ada9-4030-8364-dcab3939e408","version":1,"type":"video","titre":"La désinfection des mains par friction hydro-alcoolique","resume":null,"corps":{"duree":"2:00","credit":"Hôpital universitaire Robert-Debré · lue depuis YouTube, droits réservés à son auteur","youtube_id":"KFK7f8IMGe8"},"source":"Hôpital universitaire Robert-Debré","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène"],"essentiel":false,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-10-27T07:40:49.034591+00:00","relu":{"par":"Claire Martin","le":"2026-10-09T16:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-10-09","revision_le":"2027-10-09"},"motif_refus":null,"vues":2,"utile":2,"mon_vote":false,"reponses":[]},{"id":"1aa1f435-74e8-4c8f-9473-8228dccae8f8","racine_id":"1aa1f435-74e8-4c8f-9473-8228dccae8f8","version":1,"type":"question","titre":"Quelle hygiène des mains entre deux soins chez le même patient ?","resume":null,"corps":{},"source":"Contenu de démonstration · à valider par un référent","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène"],"essentiel":false,"statut":"publie","a_revoir":false,"auteur":{"nom":"Paul Durand","qualite":"IDE"},"cree_le":"2026-10-27T07:40:49.034591+00:00","relu":{"par":"Claire Martin","le":"2026-10-19T16:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-10-19","revision_le":"2027-10-19"},"motif_refus":null,"vues":2,"utile":1,"mon_vote":false,"reponses":[{"id":"37d6534e-92e5-40d1-8f42-982c15bb58e3","texte":"Friction hydro-alcoolique avant et après chaque soin, y compris chez le même patient quand on passe d'un site contaminé (change, plaie) à un site propre (injection, cathéter), et après le retrait des gants. Lavage au savon doux seulement si les mains sont visiblement souillées, puis friction une fois les mains sèches.","source":"SF2H, bonnes pratiques en soins de ville, 2015","auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-10-27T07:40:49.034591+00:00","validee":true,"validee_par":"Dr Hélène Marchand, Médecin","validee_le":"2026-10-19"}]},{"id":"0e14d787-440b-41d7-9fb7-f1bc62da0bb3","racine_id":"0e14d787-440b-41d7-9fb7-f1bc62da0bb3","version":1,"type":"document","titre":"Administration des médicaments en hospitalisation à domicile (synthèse)","resume":null,"corps":{"url":"https://has-sante.fr/upload/docs/application/pdf/2014-01/administration_des_medicaments_en_hospitalisation_a_domicile_had_synthese.pdf"},"source":"HAS","fiches":["MEDICAMENTS"],"tags":["médicaments"],"essentiel":false,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-10-27T07:40:49.034591+00:00","relu":{"par":"Claire Martin","le":"2026-10-01T16:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-10-01","revision_le":"2027-10-01"},"motif_refus":null,"vues":2,"utile":2,"mon_vote":false,"reponses":[]},{"id":"3d152572-73d9-4686-a555-4a694d517a5b","racine_id":"3d152572-73d9-4686-a555-4a694d517a5b","version":1,"type":"document","titre":"Bonnes pratiques essentielles en hygiène en soins de ville","resume":null,"corps":{"url":"https://www.sf2h.net/k-stock/data/uploads/2015/11/SF2H_recommandations_bonnes-pratiques-essentielles-en-hygiene-a-l-usage-des-professionnels-de-sante-en-soins-de-ville-2015.pdf"},"source":"SF2H, 2015","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène"],"essentiel":false,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-10-27T07:40:49.034591+00:00","relu":{"par":"Claire Martin","le":"2026-10-07T16:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-10-07","revision_le":"2027-10-07"},"motif_re