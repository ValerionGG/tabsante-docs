{"fiche":"SOINS_NURSING","contenus":[{"id":"052f7a36-dec7-4221-b429-63d663f2d92d","racine_id":"052f7a36-dec7-4221-b429-63d663f2d92d","version":1,"type":"geste","titre":"Friction hydro-alcoolique des mains","resume":"Avant et après chaque soin, après le retrait des gants.","corps":{"etapes":[{"texte":"Retirer bagues, montre et bracelets ; ongles courts, sans vernis.","vigilance":null},{"texte":"Déposer une dose de solution hydro-alcoolique qui remplit le creux de la main.","vigilance":"Mains visiblement souillées : lavage au savon doux d'abord, séchage complet, puis friction."},{"texte":"Frictionner paume contre paume, puis le dos de chaque main, doigts entrecroisés.","vigilance":null},{"texte":"Frictionner le dos des doigts, les pouces, puis le bout des doigts et les ongles dans la paume opposée.","vigilance":null},{"texte":"Terminer par les poignets ; frictionner jusqu'à séchage complet, sans essuyer.","vigilance":"Une friction trop courte (moins de 20 à 30 secondes) laisse des zones non désinfectées."}],"materiel":["Solution hydro-alcoolique (flacon de poche)"]},"source":"Contenu de démonstration · à valider par un référent","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène","geste important"],"essentiel":true,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-11-26T07:40:19.630435+00:00","relu":{"par":"Dr Jean Marchand","le":"2026-11-18T17:00:00+00:00"},"validation":{"par":"Dr Jean Marchand","qualite":"Médecin","le":"2026-11-18","revision_le":"2027-11-18"},"motif_refus":null,"vues":4,"utile":2,"mon_vote":false,"reponses":[]},{"id":"67efabe5-45a8-4964-a1b8-843d016ddd95","racine_id":"67efabe5-45a8-4964-a1b8-843d016ddd95","version":1,"type":"video","titre":"La friction hydro-alcoolique, comment ?","resume":null,"corps":{"duree":"1:30","credit":"Hôpitaux universitaires de Genève · lue depuis YouTube, droits réservés à son auteur","youtube_id":"IXiGWkMu27E"},"source":"Hôpitaux universitaires de Genève","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène","geste important"],"essentiel":true,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-11-26T07:40:19.630435+00:00","relu":{"par":"Claire Martin","le":"2026-11-14T17:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-11-14","revision_le":"2027-11-14"},"motif_refus":null,"vues":6,"utile":1,"mon_vote":false,"reponses":[]},{"id":"2e3615ac-544b-458d-b8bc-325be53ac868","racine_id":"2e3615ac-544b-458d-b8bc-325be53ac868","version":1,"type":"video","titre":"Désinfection des mains par friction hydro-alcoolique","resume":null,"corps":{"duree":"1:05","credit":"Gustave Roussy · lue depuis YouTube, droits réservés à son auteur","youtube_id":"_MtZJsdr824"},"source":"Gustave Roussy","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène"],"essentiel":false,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-11-26T07:40:19.630435+00:00","relu":{"par":"Claire Martin","le":"2026-11-11T17:00:00+00:00"},"validation":{"par":"Claire Martin","qualite":"IDE","le":"2026-11-11","revision_le":"2027-11-11"},"motif_refus":null,"vues":6,"utile":1,"mon_vote":false,"reponses":[]},{"id":"5b78684b-2647-43eb-95aa-d0be4415e9dc","racine_id":"5b78684b-2647-43eb-95aa-d0be4415e9dc","version":1,"type":"video","titre":"La désinfection des mains par friction hydro-alcoolique","resume":null,"corps":{"duree":"2:00","credit":"Hôpital universitaire Robert-Debré · lue d