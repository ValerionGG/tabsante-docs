{"fiche":"SOINS_NURSING","contenus":[{"id":"ecf10190-36dc-496b-86e0-7ac4a8892e64","racine_id":"ecf10190-36dc-496b-86e0-7ac4a8892e64","version":1,"type":"geste","titre":"Friction hydro-alcoolique des mains","resume":"Avant et après chaque soin, après le retrait des gants.","corps":{"etapes":[{"texte":"Retirer bagues, montre et bracelets ; ongles courts, sans vernis.","vigilance":null},{"texte":"Déposer une dose de solution hydro-alcoolique qui remplit le creux de la main.","vigilance":"Mains visiblement souillées : lavage au savon doux d'abord, séchage complet, puis friction."},{"texte":"Frictionner paume contre paume, puis le dos de chaque main, doigts entrecroisés.","vigilance":null},{"texte":"Frictionner le dos des doigts, les pouces, puis le bout des doigts et les ongles dans la paume opposée.","vigilance":null},{"texte":"Terminer par les poignets ; frictionner jusqu'à séchage complet, sans essuyer.","vigilance":"Une friction trop courte (moins de 20 à 30 secondes) laisse des zones non désinfectées."}],"materiel":["Solution hydro-alcoolique (flacon de poche)"]},"source":"Contenu de démonstration · à valider par un référent","fiches":["PANSEMENT","INJECTION","SUIVI_DIABETIQUE","PARAMETRES_VITAUX","PRELEVEMENT","ANTICOAGULANT","MEDICAMENTS","SOINS_NURSING","PERFUSION_IV","PERFUSION_SC","STOMIE_DIGESTIVE","STOMIE_URINAIRE"],"tags":["hygiène","geste important"],"essentiel":true,"statut":"publie","a_revoir":false,"auteur":{"nom":"Claire Martin","qualite":"IDE"},"cree_le":"2026-10-22T19:24:38.301927+00:00","relu":{"par":"Dr Hélène Marchand","le":"2026-10-14T16:00:00+00:00"},"validation":{"par":"Dr Hélène Marchand","qualite":"Médecin","le":"2026-10-14","revision_le":"2027-10-14"},"motif_refus":null,"vues":2,"utile":2,"mon_vote":true,"reponses":[]},{"id":"a30b6044-0ef2-4975-b0a7-46cb6f11105f","racine_id":"a30b6044-0ef2-4975-b0a7-46cb6f11105f","version":1,"type":"video","titre":"La friction hydro-alcoolique, comment ?","resume":null,"corps":{"duree":"1:30","credit":"Hôpit